# Copy this file to .env and fill in your actual credentials.
# .env is gitignored and should NEVER be committed.

# === AWS ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_INBOUND_BUCKET=pipeline-project-inbound
S3_OUTBOUND_BUCKET=pipeline-project-outbound
S3_ARCHIVE_BUCKET=pipeline-project-archive

# === Snowflake ===
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PIPELINE_PROJECT
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# === PostgreSQL (local on Pi) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pipeline_db
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=

# === GPG ===
GPG_INBOUND_KEY_ID=
GPG_VENDOR_KEY_ID=
GPG_PASSPHRASE=

# === Slack ===
SLACK_BOT_TOKEN=xoxb-
SLACK_ALERT_CHANNEL=#pipeline-alerts

# === SendGrid (backup email alerts) ===
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# === Airflow ===
AIRFLOW_HOME=/home/grant/pipeline-project/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://pipeline_user:password@localhost/airflow_db
