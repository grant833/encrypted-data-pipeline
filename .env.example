# Copy this file to .env and fill in your actual credentials.
# .env is gitignored and should NEVER be committed.

# === PostgreSQL (local on Pi) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pipeline_db
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=your-password-here

# === AWS ===
AWS_ACCESS_KEY_ID=AKIA-your-key-id-here
AWS_SECRET_ACCESS_KEY=your-secret-here
AWS_DEFAULT_REGION=us-east-1
S3_INBOUND_BUCKET=your-pipeline-inbound-bucket
S3_OUTBOUND_BUCKET=your-pipeline-outbound-bucket

# === GPG ===
# Run: gpg --list-keys --keyid-format=long
GPG_INBOUND_KEY_ID=your-16-char-inbound-key-id
GPG_VENDOR_KEY_ID=your-16-char-vendor-key-id

# === Slack ===
# Create a Slack app, install to workspace, copy the Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_ALERT_CHANNEL=your-channel-name-without-hash

# === Airflow ===
AIRFLOW_HOME=/home/grant/pipeline-project/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://pipeline_user:your-password-here@localhost/airflow_db
