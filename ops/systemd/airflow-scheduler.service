[Unit]
Description=Airflow Scheduler
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=grant
Group=grant
WorkingDirectory=/home/grant/pipeline-project
Environment="PATH=/home/grant/pipeline-project/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="AIRFLOW_HOME=/home/grant/pipeline-project/airflow"
Environment="AIRFLOW__CORE__EXECUTOR=LocalExecutor"
Environment="AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://pipeline_user:YOUR_PASSWORD_HERE@localhost/airflow_db"
Environment="AIRFLOW__CORE__LOAD_EXAMPLES=False"
Environment="AIRFLOW__CORE__DAGS_FOLDER=/home/grant/pipeline-project/dags"
Environment="PYTHONPATH=/home/grant/pipeline-project"
ExecStart=/home/grant/pipeline-project/venv/bin/airflow scheduler
Restart=always
RestartSec=10
StandardOutput=append:/home/grant/pipeline-project/airflow/scheduler-systemd.log
StandardError=append:/home/grant/pipeline-project/airflow/scheduler-systemd.log

[Install]
WantedBy=multi-user.target
